# Maintainer: Nathan Greenhaw <me@nathang.me>

# Builds hyprview from the latest git commit. Before pushing to the AUR,
# regenerate .SRCINFO:
#     makepkg --printsrcinfo > .SRCINFO

pkgname=hyprview-git
_pkgname=hyprview
pkgver=r0
pkgrel=1
pkgdesc='Lightweight workspace overview for Hyprland with live window thumbnails'
arch=('x86_64')
url="https://github.com/nnthnn/hyprview"
license=('MIT')
depends=('wayland' 'cairo' 'pango')
makedepends=('cargo' 'git')
optdepends=('hyprland: live window thumbnails via toplevel-export')
provides=('hyprview')
conflicts=('hyprview')
source=("$_pkgname::git+${url}.git")
sha256sums=('SKIP')

pkgver() {
    cd "$_pkgname"
    printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
    cd "$_pkgname"
    # Vendor dependencies up front so build() can run fully offline (--frozen).
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$_pkgname"
    cargo build --frozen --release
}

check() {
    cd "$_pkgname"
    cargo test --frozen
}

package() {
    cd "$_pkgname"
    install -Dm755 target/release/hyprview "$pkgdir/usr/bin/hyprview"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 CONTRIBUTING.md "$pkgdir/usr/share/doc/$pkgname/CONTRIBUTING.md"
    install -Dm644 docs/configuration.md "$pkgdir/usr/share/doc/$pkgname/docs/configuration.md"
    install -Dm644 docs/development.md "$pkgdir/usr/share/doc/$pkgname/docs/development.md"
    install -Dm644 config.example.toml "$pkgdir/usr/share/doc/$pkgname/config.example.toml"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
